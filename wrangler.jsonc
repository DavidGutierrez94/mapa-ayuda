{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mapa-ayuda",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-06",
  "routes": [{ "pattern": "ayuda.davidgutierrez.ai", "custom_domain": true }],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/webhook/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mapa-ayuda",
      "database_id": "90ce1126-362b-4d38-9f64-9ebcb2cfd9de",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // OpenAI-compatible endpoint; any deployer can swap provider/model.
    "LLM_BASE_URL": "https://openrouter.ai/api/v1",
    "LLM_MODEL": "anthropic/claude-haiku-4.5",
    // Feedback inbox creates issues here (needs GITHUB_TOKEN secret; otherwise reports queue in the audit log).
    "GITHUB_REPO": "DavidGutierrez94/mapa-ayuda"
  }
  // Secrets (wrangler secret put ...): LLM_API_KEY, KAPSO_API_KEY, KAPSO_PHONE_ID,
  // KAPSO_WEBHOOK_SECRET, SMSGATE_SIGNING_KEY, SMSGATE_LOGIN, SMSGATE_PASSWORD,
  // TURNSTILE_SECRET, TURNSTILE_SITEKEY, MOD_TOKEN, RESPONDER_TOKEN, ORG_TOKENS,
  // CEDULA_PEPPER (required for leader cédula HMAC — without it the pepper is empty).
  // NOTE: TURNSTILE_SECRET is now load-bearing — web intake fails CLOSED without it.
}
